# ---------- Firebase: browser keys (Project settings > General > Your apps > Web app) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase: secret server keys (Project settings > Service accounts > Generate new private key) ----------
# Copy these three values from the downloaded .json file. Never share them or commit them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n characters exactly as they are in the file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Cloudinary (free): announcement images. Optional; without it announcements are text only ----------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---------- Student Voice emails (optional). Without these, messages are logged in the terminal ----------
RESEND_API_KEY=
FINSA_TO_EMAIL=finsaunilorin67@gmail.com
FINSA_FROM_EMAIL=FINSA Cloud <onboarding@resend.dev>
